model {
  for (i in 1:N) {
    y[i] ~ dnorm(mu[i], tau_y)
    mu[i] <- alpha + inprod(beta[], X[i,]) + u[state[i]] + v[zip[i]]
  }

  alpha ~ dnorm(0, 0.16)
  for (p in 1:P) {
    beta[p] ~ dnorm(0, 1)
  }

  for (s in 1:S) {
    u[s] ~ dnorm(0, tau_state)
  }
  sd_state ~ dnorm(0, 1) T(0,)
  tau_state <- pow(sd_state, -2)

  for (z in 1:Z) {
    v[z] ~ dnorm(0, tau_zip)
  }
  sd_zip ~ dnorm(0, 1) T(0,)
  tau_zip <- pow(sd_zip, -2)

  sigma ~ dnorm(0, 1) T(0,)
  tau_y <- pow(sigma, -2)
}

model {
  for (i in 1:N) {
    y[i] ~ dnorm(mu[i], tau_resid[i])
    outlier[i] ~ dbern(p_outlier)
    tau_resid[i] <- tau_core * (1 - outlier[i]) + tau_outlier * outlier[i]
    mu[i] <- alpha + inprod(beta[], X[i,]) + u[state[i]] + v[zip[i]]
  }

  alpha ~ dnorm(0, 1)
  for (p in 1:P) {
    beta[p] ~ dnorm(0, 1111.111111)
  }

  for (s in 1:S) {
    u_raw[s] ~ dnorm(0, tau_state)
    u[s] <- u_raw[s] - u_mean
  }
  u_mean <- sum(u_raw[]) / S
  sd_state ~ dnorm(0, 11.111111) T(0,)
  tau_state <- pow(sd_state, -2)

  for (z in 1:Z) {
    v_raw[z] ~ dnorm(0, tau_zip)
    v[z] <- v_raw[z] - v_state_mean[zip_state[z]]
  }
  for (s in 1:S) {
    for (k in 1:K) {
      v_state_member[s,k] <- v_raw[zip_in_state[s,k]] * zip_in_state_weight[s,k]
    }
    v_state_sum[s] <- sum(v_state_member[s,])
    v_state_mean[s] <- v_state_sum[s] / n_zips_by_state[s]
  }
  sd_zip ~ dnorm(0, 11.111111) T(0,)
  tau_zip <- pow(sd_zip, -2)

  sigma_core ~ dnorm(0, 4) T(0,)
  sigma_extra ~ dnorm(0, tau_sigma_extra_prior) T(0,)
  sigma_outlier <- sigma_core + sigma_extra
  tau_core <- pow(sigma_core, -2)
  tau_outlier <- pow(sigma_outlier, -2)
  p_outlier ~ dbeta(p_outlier_alpha, p_outlier_beta)
}

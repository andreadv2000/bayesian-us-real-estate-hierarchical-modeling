model {
  for (i in 1:N) {
    y[i] ~ dt(mu[i], tau_y, nu)
    mu[i] <- alpha + inprod(beta[], X[i,]) + u[state[i]] + v[zip[i]]
  }

  alpha ~ dnorm(0, 1)
  for (p in 1:P) {
    beta[p] ~ dnorm(0, 1111.111111)
  }

  for (s in 1:S) {
    u[s] ~ dnorm(0, tau_state)
  }
  sd_state ~ dnorm(0, 11.111111) T(0,)
  tau_state <- pow(sd_state, -2)

  for (z in 1:Z) {
    v[z] ~ dnorm(0, tau_zip)
  }
  sd_zip ~ dnorm(0, 11.111111) T(0,)
  tau_zip <- pow(sd_zip, -2)

  sigma ~ dnorm(0, 4) T(0,)
  tau_y <- pow(sigma, -2)

  # The lower bound gives the Student-t residual distribution finite variance.
  nu_minus_two ~ dexp(0.033333333)
  nu <- nu_minus_two + 2
}
